# ═══════════════════════════════════════════════════
# NEO.PRO BACKEND — Environment Variables
# Copy ke Railway: Settings > Variables
# ═══════════════════════════════════════════════════

# ── WAJIB ──────────────────────────────────────────
# URL frontend Cloudflare Pages (tanpa trailing slash)
FRONTEND_URL=https://neopro.pages.dev

# ── AI ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── WHATSAPP BUSINESS ──────────────────────────────
WHATSAPP_TOKEN=EAAxxxxxxxxxxxx
WHATSAPP_PHONE_ID=1234567890
WHATSAPP_VERIFY_TOKEN=neopro_webhook_secret

# ── TELEGRAM ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCxxxxxxxxxxxxxxxxxxxx

# ── SLACK ──────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxx

# ── EMAIL (Resend — gratis 3000/bulan) ─────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── SHOPEE ─────────────────────────────────────────
SHOPEE_PARTNER_ID=123456
SHOPEE_PARTNER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPEE_SHOP_ID=123456789
SHOPEE_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── TOKOPEDIA ──────────────────────────────────────
TOKOPEDIA_CLIENT_ID=xxxxxxxxxxxxxxxx
TOKOPEDIA_CLIENT_SECRET=xxxxxxxxxxxxxxxx
TOKOPEDIA_FS_ID=123456

# ── MIDTRANS ───────────────────────────────────────
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_PRODUCTION=false

# ── XENDIT ─────────────────────────────────────────
XENDIT_API_KEY=xnd_production_xxxxxxxxxxxxxxxxxxxx
